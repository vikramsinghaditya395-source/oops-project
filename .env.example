# VoltFlow - Full-Stack Environment Variables Template

# Frontend Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Spring Boot Backend Port
SERVER_PORT=8080

# Spring Mail (SMTP Settings for Live OTP Delivery)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# Database Configuration (Defaults to H2 in-memory; uncomment for MySQL)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=voltflow_db
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
